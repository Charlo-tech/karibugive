<%- include('partials/header', { title: 'Admin — Karibu Give' }) %>

<section class="admin">
  <div class="section-inner">
    <div class="admin-head">
      <h1>Admin Dashboard</h1>
      <div class="admin-actions">
        <form id="syncForm"><button type="submit" class="btn btn-ghost">↻ Batch sync to Snowflake</button></form>
        <span id="syncStatus" class="muted small"></span>
      </div>
    </div>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash flash-success"><%= flash %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash flash-error"><%= error %></div>
    <% } %>

    <!-- Summary cards -->
    <div class="kpi-grid">
      <div class="kpi">
        <span class="kpi-label">Total raised</span>
        <strong class="kpi-value">KES <%= stats.totalRaised.toLocaleString() %></strong>
        <span class="kpi-sub"><%= stats.completed %> completed gifts</span>
      </div>
      <div class="kpi">
        <span class="kpi-label">Total donations</span>
        <strong class="kpi-value"><%= stats.totalDonations %></strong>
        <span class="kpi-sub">all statuses</span>
      </div>
      <div class="kpi kpi-small">
        <span class="kpi-label">Completed</span><strong><%= stats.completed %></strong>
      </div>
      <div class="kpi kpi-small kpi-warn">
        <span class="kpi-label">Pending</span><strong><%= stats.pending %></strong>
      </div>
      <div class="kpi kpi-small kpi-danger">
        <span class="kpi-label">Failed</span><strong><%= stats.failed %></strong>
      </div>
    </div>

    <!-- Progress by cause (active-aware) -->
    <div class="admin-causes">
      <% raisedByCause.forEach(c => { %>
        <div class="mini-cause" style="<%= c.is_active ? '' : 'opacity:.6;border-style:dashed' %>">
          <span><%= c.emoji %> <strong><%= c.name %></strong> <% if(c.is_active){ %><span class="badge-active">● active</span><% } else { %><span class="badge-inactive">○ inactive</span><% } %></span>
          <span>KES <%= c.raised.toLocaleString() %> / <%= c.target_amount.toLocaleString() %> (<%= c.progress %>%)</span>
          <div class="progress-bar small"><div class="progress-fill" style="width: <%= c.progress %>%"></div></div>
        </div>
      <% }) %>
    </div>

    <!-- === MANAGE CAUSES === -->
    <section class="causes-manage">
      <div class="causes-manage-head">
        <h2>Manage Charity Causes</h2>
        <span class="muted small">
          <%= typeof activeCauses !== 'undefined' ? activeCauses.length : raisedByCause.filter(c=>c.is_active).length %> of <%= maxActive %> active — only <strong>3 active</strong> at any time (USSD + landing show active only)
        </span>
      </div>

      <% const _activeCount = (typeof activeCauses !== 'undefined' ? activeCauses.length : raisedByCause.filter(c=>c.is_active).length); %>
      <% const _canActivate = _activeCount < maxActive; %>

      <!-- All causes table -->
      <div class="table-wrap" style="margin: .8rem 0 1rem">
        <table class="tbl">
          <thead>
            <tr>
              <th>Emoji</th><th>Name / ID</th><th>Description</th><th>Target</th><th>Raised</th><th>Status</th><th style="min-width:280px">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% (allCauses || raisedByCause).forEach(c => {
                 const raised = raisedByCause.find(r=>r.id===c.id);
                 const rAmt = raised ? raised.raised : 0;
                 const rPct = raised ? raised.progress : 0;
            %>
              <tr>
                <td style="text-align:center;font-size:1.3rem"><%= c.emoji %></td>
                <td>
                  <strong><%= c.name %></strong><br>
                  <span class="mono small muted"><%= c.id %></span>
                </td>
                <td class="small" style="max-width:280px;white-space:normal"><%= c.description || '—' %></td>
                <td>KES <%= c.target_amount.toLocaleString() %></td>
                <td>
                  KES <%= rAmt.toLocaleString() %><br>
                  <span class="small muted"><%= rPct %>%</span>
                </td>
                <td>
                  <% if (c.is_active) { %>
                    <span class="status status-completed">active</span>
                  <% } else { %>
                    <span class="status" style="background:#f3f4f6;color:#6b7280">inactive</span>
                  <% } %>
                </td>
                <td>
                  <div style="display:flex;gap:.4rem;flex-wrap:wrap;align-items:center">
                    <!-- Toggle active -->
                    <form method="POST" action="/admin/causes/<%= c.id %>/toggle" style="display:inline">
                      <% if (c.is_active) { %>
                        <button type="submit" class="btn btn-ghost btn-sm" title="Deactivate — will hide from USSD/landing">Deactivate</button>
                      <% } else { %>
                        <button type="submit" class="btn btn-sm <%= _canActivate ? 'btn-primary' : '' %>" <%= _canActivate ? '' : 'disabled title="Already 3 active — deactivate one first"' %>>
                          <%= _canActivate ? 'Activate' : 'Full (3/3)' %>
                        </button>
                      <% } %>
                    </form>
                    <!-- Delete -->
                    <form method="POST" action="/admin/causes/<%= c.id %>/delete" style="display:inline" onsubmit="return confirm('Delete cause <%= c.name %>? Only allowed if no donations exist.')">
                      <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);border-color:#fecaca">Delete</button>
                    </form>
                    <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('edit-<%= c.id %>').classList.toggle('hidden')">Edit</button>
                  </div>
                  <!-- Inline edit form -->
                  <form id="edit-<%= c.id %>" method="POST" action="/admin/causes/<%= c.id %>/edit" class="hidden" style="margin-top:.6rem;display:grid;gap:.4rem;background:#fffaf3;padding:.6rem;border-radius:8px;border:1px dashed var(--border)">
                    <input name="name" value="<%= c.name %>" placeholder="Name" required style="padding:.45rem;border:1px solid #e5e7eb;border-radius:6px">
                    <input name="emoji" value="<%= c.emoji %>" placeholder="Emoji" maxlength="4" style="padding:.45rem;border:1px solid #e5e7eb;border-radius:6px;width:90px">
                    <input name="target_amount" type="number" value="<%= c.target_amount %>" min="1000" step="1000" required style="padding:.45rem;border:1px solid #e5e7eb;border-radius:6px">
                    <textarea name="description" rows="2" placeholder="Description" style="padding:.45rem;border:1px solid #e5e7eb;border-radius:6px;resize:vertical"><%= c.description %></textarea>
                    <div style="display:flex;gap:.4rem">
                      <button type="submit" class="btn btn-primary btn-sm">Save</button>
                      <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('edit-<%= c.id %>').classList.add('hidden')">Cancel</button>
                    </div>
                  </form>
                </td>
              </tr>
            <% }) %>
            <% if ((allCauses || []).length === 0) { %>
              <tr><td colspan="7" class="muted center">No causes yet — add one below.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Add cause form -->
      <div class="add-cause-card">
        <h3 style="margin:.2rem 0">Add New Cause</h3>
        <p class="muted small" style="margin:0 0 .6rem">
          <% if (!_canActivate) { %>
            <span style="color:var(--warn);font-weight:700">⚠ 3 active causes already — new cause will be added as <em>inactive</em>. Deactivate one to make room.</span>
          <% } else { %>
            You can activate this cause immediately (<%= _activeCount %>/<%= maxActive %> active).
          <% } %>
        </p>
        <form method="POST" action="/admin/causes" class="add-cause-form">
          <div class="form-grid">
            <label>Name *
              <input name="name" required placeholder="e.g. Girls Education" maxlength="60">
            </label>
            <label>Emoji
              <input name="emoji" placeholder="🎓" maxlength="4" value="❤️">
            </label>
            <label>Target (KES) *
              <input name="target_amount" type="number" required min="1000" step="1000" value="300000">
            </label>
            <label style="display:flex;align-items:center;gap:.4rem;margin-top:1.4rem">
              <input type="checkbox" name="is_active" <%= _canActivate ? 'checked' : '' %> <%= _canActivate ? '' : 'disabled' %>>
              <span>Active <%= _canActivate ? '' : '(max reached)' %></span>
            </label>
          </div>
          <label>Description
            <textarea name="description" rows="2" placeholder="What will donations fund? Be specific for donor transparency." style="width:100%"></textarea>
          </label>
          <button type="submit" class="btn btn-primary" style="margin-top:.6rem">Add Cause</button>
        </form>
      </div>
    </section>

    <!-- Two distinct AI cards -->
    <div class="ai-grid">
      <!-- Google AI Impact Summary -->
      <div class="ai-card ai-google">
        <div class="ai-card-head">
          <h3>✨ Google AI Impact Summary</h3>
          <span class="ai-badge google-badge">Gemini 1.5 Flash</span>
        </div>
        <p class="muted small">Plain-language donor transparency paragraph — summarizes recent completed donations for public accountability. Powered by <code>@google/generative-ai</code>.</p>
        <div id="googleSummary" class="ai-output placeholder">Click "Generate summary" to create a donor-facing impact paragraph.</div>
        <div class="ai-actions">
          <button id="genGoogle" class="btn btn-primary">Generate summary</button>
          <span id="googleMeta" class="muted small"></span>
        </div>
      </div>

      <!-- Snowflake Cortex Analytics -->
      <div class="ai-card ai-snowflake">
        <div class="ai-card-head">
          <h3>❄️ Snowflake AI Analytics</h3>
          <span class="ai-badge snow-badge">Cortex COMPLETE · llama3-8b</span>
        </div>
        <p class="muted small">Trend analysis over <code>DONATIONS_ANALYTICS</code> — uses <code>SNOWFLAKE.CORTEX.COMPLETE('llama3-8b', …)</code> on aggregates (totals by cause, daily trend, largest gift).</p>
        <div id="cortexSummary" class="ai-output placeholder">Click "Refresh analytics" to run the Cortex query on demand.</div>
        <div class="ai-actions">
          <button id="genCortex" class="btn btn-snow">Refresh analytics</button>
          <span id="cortexMeta" class="muted small"></span>
        </div>
      </div>
    </div>

    <!-- Filters -->
    <form method="GET" action="/admin" class="filters">
      <label> Status
        <select name="status">
          <option value="">All</option>
          <option value="pending" <%= filters.status==='pending'?'selected':'' %>>Pending</option>
          <option value="completed" <%= filters.status==='completed'?'selected':'' %>>Completed</option>
          <option value="failed" <%= filters.status==='failed'?'selected':'' %>>Failed</option>
        </select>
      </label>
      <label> Cause
        <select name="cause_id">
          <option value="">All</option>
          <% (allCauses||causes).forEach(c=>{ %><option value="<%=c.id%>" <%=filters.cause_id===c.id?'selected':''%>><%=c.name%></option><% }) %>
        </select>
      </label>
      <button type="submit" class="btn btn-sm">Filter</button>
      <a href="/admin" class="btn btn-ghost btn-sm">Clear</a>
    </form>

    <!-- Donations table -->
    <div class="table-wrap">
      <table class="tbl">
        <thead>
          <tr>
            <th>#</th><th>Phone (masked)</th><th>Cause</th><th>Amount</th><th>Status</th><th>Checkout ID</th><th>Created</th><th>Synced</th>
          </tr>
        </thead>
        <tbody>
          <% if (donations.length===0) { %>
            <tr><td colspan="8" class="muted center">No donations match this filter yet. Try the USSD simulator below or dial <%= process.env.AT_USSD_CODE || '*384*1234#' %>.</td></tr>
          <% } %>
          <% donations.forEach(d=>{ %>
            <tr>
              <td><%= d.id %></td>
              <td class="mono"><%= d.phone_masked %></td>
              <td><span class="pill"><%= d.cause_id %></span></td>
              <td>KES <%= d.amount.toLocaleString() %></td>
              <td><span class="status status-<%= d.status %>"><%= d.status %></span></td>
              <td class="mono small" title="<%= d.checkout_request_id %>"><%= d.checkout_request_id ? d.checkout_request_id.slice(0,18) : '—' %></td>
              <td class="small"><%= d.created_at %></td>
              <td><%= d.synced_to_snowflake ? '✓' : '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Dev helpers -->
    <details class="dev-box">
      <summary>Developer helpers (USSD & payment simulation)</summary>
      <div class="dev-grid">
        <div>
          <h4>Simulate USSD</h4>
          <p class="small muted">POST /ussd with sessionId, phoneNumber, text (uses currently <strong>active</strong> causes only)</p>
          <pre class="code">curl -X POST http://localhost:3000/ussd \
  -d "sessionId=TEST123&phoneNumber=%2B254711082000&text="

# Then:
# text=1      (Donate — lists active causes)
# text=1*1    (Cause 1 of active list)
# text=1*1*100 (Amount 100)
# text=1*1*100*1 (Confirm — triggers STK push)</pre>
        </div>
        <div>
          <h4>Simulate payment callback</h4>
          <pre class="code">curl -X POST http://localhost:3000/payment-callback \
  -H "Content-Type: application/json" \
  -d '{"checkoutRequestId":"MOCK-...","status":"Success"}'

# Or Daraja style:
# curl -X POST http://localhost:3000/mpesa-callback \
#  -d '{"Body":{"stkCallback":{"CheckoutRequestID":"ws_CO_...","ResultCode":0}}}'</pre>
          <div style="margin-top:1rem">
            <label class="small">Checkout ID to mark completed</label>
            <div style="display:flex;gap:.5rem;margin-top:.25rem">
              <input id="simId" placeholder="MOCK-..." style="flex:1;padding:.5rem;border:1px solid #ddd;border-radius:8px">
              <button id="simBtn" class="btn btn-sm">Mark completed</button>
            </div>
            <span id="simStatus" class="small muted"></span>
          </div>
        </div>
      </div>
    </details>
  </div>
</section>

<style>
.causes-manage{margin:1.2rem 0 1.4rem;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:1rem}
.causes-manage-head{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap}
.causes-manage-head h2{margin:0;font-size:1.2rem}
.badge-active{font-size:.7rem;background:#dcfce7;color:#166534;padding:.15rem .4rem;border-radius:999px;font-weight:700}
.badge-inactive{font-size:.7rem;background:#f3f4f6;color:#6b7280;padding:.15rem .4rem;border-radius:999px}
.add-cause-card{background:#fff7ed;border:1px solid #fde68a;border-radius:12px;padding:.9rem;margin-top:.8rem}
.add-cause-form label{font-size:.85rem;font-weight:600;display:grid;gap:.25rem}
.add-cause-form input,.add-cause-form textarea{padding:.5rem;border:1px solid #e5e7eb;border-radius:8px;background:#fff;font:inherit}
.form-grid{display:grid;grid-template-columns:1.2fr .4fr .7fr auto;gap:.7rem;align-items:end}
@media(max-width:800px){.form-grid{grid-template-columns:1fr 1fr}}
.flash{padding:.7rem .9rem;border-radius:10px;margin-bottom:.9rem;font-weight:600}
.flash-success{background:#dcfce7;border:1px solid #bbf7d0;color:#166534}
.flash-error{background:#fee2e2;border:1px solid #fecaca;color:#991b1b}
.hidden{display:none !important}
</style>

<script>
(function(){
  const $ = s => document.getElementById(s);

  // Google AI
  $('genGoogle')?.addEventListener('click', async () => {
    const btn = $('genGoogle'), out = $('googleSummary'), meta = $('googleMeta');
    btn.disabled = true; btn.textContent = 'Generating...';
    out.textContent = 'Asking Gemini for a transparency summary...';
    out.className = 'ai-output';
    try {
      const r = await fetch('/admin/generate-impact', { method:'POST' });
      const data = await r.json();
      if (!r.ok) { out.textContent = data.error || 'Failed'; meta.textContent=''; }
      else { out.textContent = data.summary || JSON.stringify(data); meta.textContent = data.mock ? 'Mock mode — set GOOGLE_AI_API_KEY for live Gemini' : 'Generated by Gemini 1.5 Flash'; }
    } catch(e){ out.textContent = 'Error: '+e.message; }
    btn.disabled=false; btn.textContent='Generate summary';
  });

  // Cortex
  $('genCortex')?.addEventListener('click', async () => {
    const btn=$('genCortex'), out=$('cortexSummary'), meta=$('cortexMeta');
    btn.disabled=true; btn.textContent='Querying Snowflake...';
    out.textContent='Running Cortex COMPLETE on DONATIONS_ANALYTICS...';
    out.className='ai-output';
    try{
      const r=await fetch('/admin/generate-cortex',{method:'POST'});
      const data=await r.json();
      out.textContent=data.summary||JSON.stringify(data);
      meta.textContent=data.mock?'Local fallback — configure Snowflake for live Cortex':'Generated by Snowflake Cortex (llama3-8b)';
    }catch(e){ out.textContent='Error: '+e.message; }
    btn.disabled=false; btn.textContent='Refresh analytics';
  });

  // Sync
  $('syncForm')?.addEventListener('submit', async e=>{
    e.preventDefault();
    const s=$('syncStatus'); s.textContent='Syncing...';
    try{
      const r=await fetch('/admin/sync-snowflake',{method:'POST'});
      const data=await r.json();
      s.textContent = `Synced ${data.total} row(s). ` + (data.results?.length? data.results.map(x=>`#${x.id}:${x.mock?'mock':'live'}`).join(', ') : '');
      setTimeout(()=>location.reload(), 1200);
    }catch(err){ s.textContent='Error: '+err.message; }
  });

  // Sim payment
  $('simBtn')?.addEventListener('click', async ()=>{
    const id=$('simId').value.trim(); const s=$('simStatus');
    if(!id) return s.textContent='Enter checkout id';
    s.textContent='Sending...';
    try{
      const r=await fetch('/payment-callback/simulate',{method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({checkoutRequestId:id, status:'Success'})});
      const data=await r.json();
      s.textContent = r.ok ? 'Marked completed: #'+(data.donation?.id||'') : (data.error||'failed');
      if(r.ok) setTimeout(()=>location.reload(),800);
    }catch(e){ s.textContent='Error:'+e.message; }
  });
})();
</script>

<%- include('partials/footer') %>
